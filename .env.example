# Optional absolute path outside OneDrive. Leave blank to use:
# <Windows user home>/AppData/Local/CoachLab/coachlab.sqlite
# Example: DATABASE_PATH=C:/LocalData/CoachLab/coachlab.sqlite
DATABASE_PATH=
# Server only. Use a Gemini project with billing disabled; never use VITE_ secrets.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Select sqlite (default) or postgresql explicitly; no automatic fallback.
COACHLAB_DATABASE=sqlite
# PostgreSQL development placeholders; Prisma CLI stays offline by default.
# Put real Neon values only in ignored .env. Never paste URLs into chat or logs.
COACHLAB_DEV_DATABASE_URL=
COACHLAB_DEV_DIRECT_URL=
COACHLAB_DB_ENV=
COACHLAB_DEV_EXPECTED_HOST=
COACHLAB_DEV_EXPECTED_DATABASE=
# Record non-secret Neon project/branch identity for review before any remote operation.
COACHLAB_DEV_PROJECT_ID=
COACHLAB_DEV_BRANCH_ID=
COACHLAB_TEST_DATABASE_URL=
COACHLAB_TEST_DIRECT_URL=
# Reserved for a future deployment secret store. Leave production unset locally.
COACHLAB_PROD_DATABASE_URL=
COACHLAB_PROD_DIRECT_URL=
