// Describes stored records for Prisma; changes reach the database only through reviewed migrations.
generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// A lesson belongs to one coach; older ownerless rows stay hidden until explicitly claimed.
model Lesson {
  id               Int      @id @default(autoincrement())
  title            String   @db.Text
  discipline       String   @db.Text
  // Optional Fitness metadata; legacy records need no rewriting.
  class_type       String?  @db.Text
  class_type_other String?  @db.VarChar(40)
  class_format     String?  @db.Text
  audience         String?  @default("Unspecified") @db.Text
  skill_level      String   @default("Beginner") @db.Text
  duration_minutes Int?
  goal             String   @default("") @db.Text
  drills           String   @default("") @db.Text
  coaching_notes   String   @default("") @db.Text
  created_at       DateTime @default(now()) @db.Timestamptz(3)
  media            LessonMedia[]
  owner_id         String?
  owner            User?    @relation(fields: [owner_id], references: [id], onDelete: Restrict)

  @@index([owner_id])
  @@map("lessons")
}

// Attachments can stay pending until a lesson save assigns them to a lesson.
model LessonMedia {
  id          Int      @id @default(autoincrement())
  lesson_id   Int?
  position    Int      @default(0)
  kind        String   @db.Text
  origin      String   @db.Text
  url         String?  @db.Text
  title       String   @default("") @db.Text
  activity    String   @default("") @db.Text
  mime        String?  @db.Text
  size_bytes  Int?
  data        Bytes?
  credit      String   @default("") @db.Text
  source_page String?  @db.Text
  created_at  DateTime @default(now()) @db.Timestamptz(3)
  lesson      Lesson?  @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  owner_id    String?
  owner       User?    @relation(fields: [owner_id], references: [id], onDelete: Restrict)

  @@index([lesson_id])
  @@index([owner_id])
  @@map("lesson_media")
}

// Better Auth uses this coach identity to connect sessions and owned lessons.
model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  lessons       Lesson[]
  media         LessonMedia[]

  @@map("auth_users")
}

// Sessions let the server recognize a signed-in coach without resending their password.
model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// Account records belong to the authentication library, not the lesson editor.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("auth_accounts")
}

// Time-limited verification records support authentication flows.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

// Authentication throttling is stored separately from in-memory AI and video quotas.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}
