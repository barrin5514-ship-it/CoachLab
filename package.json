{
  "name": "coachlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build --config client/vite.config.js",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "test": "node --test server/database.test.js server/api.test.js server/ai.test.js server/lesson-ui.test.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate && tsc -p tsconfig.prisma.json",
    "test:prisma": "npm run prisma:generate && node --test server/prisma-setup.test.js server/prisma-compatibility.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "prisma@7.10.0": {
      "mysql2": "3.24.6"
    },
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
