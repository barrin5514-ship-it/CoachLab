{
  "name": "coachlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build --config client/vite.config.js",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "test": "node --test server/database.test.js server/api.test.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
